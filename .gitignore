# Virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging and tooling caches
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Editor and IDE state
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Local-only configuration and secrets.
# Streamlit reads st.secrets from here; ROBO-SIM needs no secrets, but the
# ignore keeps a stray local file from ever being committed.
.streamlit/secrets.toml
.env
.env.*

# Generated experiment output. The CSVs are reproducible by running
# `python -m robo_sim.experiments`, so they are not kept in version control.
results/*.csv
